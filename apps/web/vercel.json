{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm --dir ../.. install --frozen-lockfile",
  "buildCommand": "pnpm --dir ../../packages/agent-drive build && node scripts/prepare-cli-tarball.mjs && pnpm build",
  "git": { "deploymentEnabled": { "**": false, "prod": true } },
  "crons": [
    { "path": "/api/cron/maintenance?job=cleanup", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/maintenance?job=billing", "schedule": "0 * * * *" }
  ]
}
