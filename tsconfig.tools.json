{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "playwright.config.ts",
    "vitest.integration.config.ts",
    "vitest.mcp.config.ts",
    "vitest.unit.config.ts",
    "tests/e2e/**/*.ts",
    "tests/**/*.unit.test.ts"
  ],
  "exclude": ["node_modules", "apps", "packages"]
}
