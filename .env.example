# Local development only. These credentials are public placeholders, not secrets.
POSTGRES_DB=agent_drive
POSTGRES_USER=agent_drive
POSTGRES_PASSWORD=agent_drive_local_only
DATABASE_URL=postgresql://agent_drive:agent_drive_local_only@localhost:5432/agent_drive

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=agent-drive-local
S3_ACCESS_KEY_ID=agent_drive_local
S3_SECRET_ACCESS_KEY=agent_drive_local_secret

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
AGENT_DRIVE_API_URL=http://localhost:3000/api

# Generate at least 32 random characters for Vercel Production.
CRON_SECRET=

# Use one variable per drive, e.g. AGENT_DRIVE_KEY_SUPPORT_BOT.
# Store a real 32-byte key only in a secure local secret manager.
AGENT_DRIVE_KEY_EXAMPLE=replace-with-a-32-byte-drive-key

STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_DEVELOPER_PRICE_ID=price_replace_me
STRIPE_TEAM_PRICE_ID=price_replace_me
STRIPE_USAGE_PRICE_ID=price_replace_me
STRIPE_METER_EVENT_NAME=agent_drive_usage
AGENT_DRIVE_PUBLIC_URL=http://localhost:3100
S3_LOGS_BUCKET=
S3_LOGS_PREFIX=
# Set to none when the storage provider does not charge for egress.
S3_EGRESS_METERING=
API_KEY_REQUESTS_PER_MINUTE=600
BILLING_DRIVE_MONTH_CENTS=
BILLING_STORAGE_GIB_MONTH_CENTS=
BILLING_EGRESS_GIB_CENTS=
BILLING_OPERATIONS_1000_CENTS=
EMAIL_FROM=Agent Drive <noreply@example.test>
RESEND_API_KEY=replace-me
