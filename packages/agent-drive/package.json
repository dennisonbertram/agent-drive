{
  "name": "@dennisonbertram/agent-drive",
  "version": "0.1.1",
  "description": "Command-line client and MCP server for Agent Drive, an encrypted file drive for AI agents.",
  "homepage": "https://agentdrive.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dennisonbertram/agent-drive.git",
    "directory": "packages/agent-drive"
  },
  "bugs": {
    "url": "https://github.com/dennisonbertram/agent-drive/issues"
  },
  "keywords": [
    "agent",
    "ai-agents",
    "mcp",
    "cli",
    "storage",
    "file-drive"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./crypto": {
      "types": "./dist/crypto.d.ts",
      "import": "./dist/crypto.js"
    }
  },
  "bin": {
    "agent-drive": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && node -e \"const f=require('fs');f.chmodSync('dist/cli.js',0o755);f.copyFileSync('../../skills/agent-drive/SKILL.md','dist/SKILL.md')\"",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.15.6",
    "pg": "8.23.1"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "MIT"
}
